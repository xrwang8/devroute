{
  "manifest_version": 3,
  "name": "DevRoute",
  "version": "1.0.0",
  "description": "将请求中的服务名替换为本地服务名，方便本地联调",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DevRoute",
    "default_icon": "tubiao.png"
  },
  "icons": {
    "128": "tubiao.png"
  }
}
